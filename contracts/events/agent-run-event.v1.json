{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://askmetric.dev/contracts/events/agent-run-event.v1.json",
  "title": "AskMetric Agent Run Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "schemaVersion",
    "eventType",
    "sequence",
    "occurredAt",
    "conversationId",
    "runId",
    "message",
    "source"
  ],
  "properties": {
    "eventId": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 1 },
    "eventType": { "enum": ["agent.run.accepted", "agent.run.progress", "agent.run.clarification", "agent.run.plan", "agent.run.finding", "agent.run.completed", "agent.run.failed", "agent.run.cancelled"] },
    "sequence": { "type": "integer", "minimum": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "conversationId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "message": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "source": { "type": "string", "minLength": 1 },
    "finding": { "$ref": "#/$defs/finding" }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conclusion", "metricDefinitionVersionId", "verified", "evidenceSnapshotIds", "assumptions", "uncertainties"],
      "properties": {
        "conclusion": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "metricDefinitionVersionId": { "type": "string", "minLength": 1 },
        "verified": { "type": "boolean" },
        "evidenceSnapshotIds": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "string", "minLength": 1 } },
        "assumptions": { "type": "array", "maxItems": 10, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "uncertainties": { "type": "array", "maxItems": 10, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "eventType": { "const": "agent.run.finding" } } },
      "then": { "required": ["finding"] }
    }
  ]
}
